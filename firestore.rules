rules_version = '2';

// Maskob orders — access model
// Every device signs in anonymously. Entering a sign-in code creates sessions/{uid}
// holding {role, branch, h}; the write is accepted only when h equals the stored hash
// for that role (or that branch) in config/pins, so only someone who knows the code
// can open a session. Changing or deleting a code invalidates its sessions at once.
//
// Roles:
//   admin     — system admin: sign-in codes, branches, WhatsApp settings. No orders.
//   manager   — operations management: approvals, reports, all orders, forecasts. No settings.
//   warehouse — prepares approved orders, receives returns.
//   branch    — its own orders only.
//   hr        — human resources: employees and leave records only.
//
// Sign-in: either a shared department code (config/pins) or a personal account (users/{id}).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function pinsPath() { return /databases/$(db)/documents/config/pins; }
    function pins() { return get(pinsPath()).data; }
    function sessPath() { return /databases/$(db)/documents/sessions/$(request.auth.uid); }
    function sess() { return get(sessPath()).data; }

    function hashFor(role, branch) {
      return role == 'branch' ? pins().br[branch] : pins()[role];
    }
    // personal accounts: users/{id} holds the code hash, role and branch; a session that names
    // an account is valid only while that account exists, is active and still matches
    function userPath(u) { return /databases/$(db)/documents/users/$(u); }
    function accountOk(d) {
      return exists(userPath(d.user))
        && get(userPath(d.user)).data.h == d.h
        && get(userPath(d.user)).data.active == true
        && get(userPath(d.user)).data.role == d.role
        && (d.role != 'branch' || get(userPath(d.user)).data.branch == d.get('branch', ''));
    }
    // a session (or a session being created) is backed either by an account or by a shared code
    function codeMatches(d) {
      return ('user' in d) ? accountOk(d) : hashFor(d.role, d.get('branch', '')) == d.h;
    }
    function valid() {
      return signedIn() && exists(sessPath()) && exists(pinsPath()) && codeMatches(sess());
    }
    function isRole(r) { return valid() && sess().role == r; }
    function isAdmin() { return isRole('admin'); }
    function isMgr() { return isRole('manager'); }
    function adminSet() { return 'admin' in pins(); }

    match /config/pins {
      // system admin manages all codes; operations management may read and add the
      // system admin code only once, while none exists yet (first-time handover)
      allow read: if isAdmin() || (isMgr() && !('admin' in resource.data));
      allow create: if signedIn() && !exists(pinsPath());
      allow update: if isAdmin()
        || (isMgr() && !('admin' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin']));
      allow delete: if false;
    }

    // codes/{hash} -> {role, branch}: lets a device find which role a code belongs to with
    // one direct read. Only fetchable by exact hash (no listing), so knowing the code is required.
    match /codes/{h} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdmin()
        || (isMgr() && !adminSet() && request.resource.data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    // WhatsApp notification settings (warehouse numbers): system admin only.
    // The server function reads it with admin rights.
    match /config/notify {
      allow read, write: if isAdmin();
    }

    // warehouse WhatsApp number for the "notify on WhatsApp" button: any signed-in role reads it
    match /config/contact {
      allow read: if valid();
      allow write: if isAdmin();
    }

    match /config/main {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && !exists(/databases/$(db)/documents/config/main));
    }

    match /sessions/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && exists(pinsPath())
        && request.resource.data.role in ['admin', 'manager', 'warehouse', 'branch', 'hr']
        && codeMatches(request.resource.data);
    }

    // personal accounts: managed by the system admin only (the code hash never leaves this collection
    // except through codes/{hash}, which can only be fetched by someone who knows the code)
    match /users/{id} {
      allow read, write: if isAdmin();
    }

    // activity log: every signed-in person adds entries about their own actions; only the system admin reads
    match /log/{id} {
      allow create: if valid() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    function isBranch() { return valid() && sess().role == 'branch'; }
    function myBranch() { return sess().branch; }

    // daily sales: a branch writes and reads its own days; operations reads and corrects all
    match /sales/{id} {
      allow read: if isMgr() || (isBranch() && resource.data.branch == myBranch());
      allow create: if isMgr() || (isBranch() && request.resource.data.branch == myBranch());
      allow update: if isMgr() || (isBranch() && resource.data.branch == myBranch() && request.resource.data.branch == myBranch());
      allow delete: if isMgr();
    }

    // monthly targets per branch: set by operations
    match /targets/{b} {
      allow read: if isMgr() || (isBranch() && myBranch() == b);
      allow write: if isMgr();
    }

    // maintenance reports: a branch files its own; operations follows up and closes them
    match /maintenance/{id} {
      allow read: if isMgr() || (isBranch() && resource.data.branch == myBranch());
      allow create: if isBranch() && request.resource.data.branch == myBranch() && request.resource.data.status == 'open';
      allow update: if isMgr()
        || (isBranch() && resource.data.branch == myBranch() && request.resource.data.branch == myBranch()
            && request.resource.data.status == resource.data.status);
      allow delete: if isMgr();

      // photos (compressed JPEG data, one document each)
      match /photos/{p} {
        allow read: if isMgr()
          || (isBranch() && get(/databases/$(db)/documents/maintenance/$(id)).data.branch == myBranch());
        allow create: if isBranch() && request.resource.data.branch == myBranch()
          && get(/databases/$(db)/documents/maintenance/$(id)).data.branch == myBranch()
          && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        allow delete: if isMgr();
      }
    }

    // daily inspection checklist results
    match /checks/{id} {
      allow read: if isMgr() || (isBranch() && resource.data.branch == myBranch());
      allow create: if isBranch() && request.resource.data.branch == myBranch();
      allow update: if isBranch() && resource.data.branch == myBranch() && request.resource.data.branch == myBranch();
      allow delete: if isMgr();
    }

    // company details (letterhead): system admin edits; every role reads them for printed documents and Excel exports
    match /config/company {
      allow read: if valid();
      allow write: if isAdmin();
    }
    match /config/companyLogo {
      allow read: if valid();
      allow write: if isAdmin() && request.resource.data.data is string && request.resource.data.data.size() < 600000;
      allow delete: if isAdmin();
    }

    // item catalog for orders: every signed-in role reads, system admin edits
    match /config/catalog {
      allow read: if valid();
      allow write: if isAdmin();
    }

    // checklist items: every signed-in role reads, system admin edits
    match /config/checklist {
      allow read: if valid();
      allow write: if isAdmin();
    }

    // human resources: employee files and leave records, visible to HR only
    match /employees/{id} {
      allow read, write: if isRole('hr');
      // attachments: file details + the file itself split into pieces
      match /files/{f} {
        allow read, write: if isRole('hr');
        match /parts/{p} {
          allow read, delete: if isRole('hr');
          allow create, update: if isRole('hr') && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        }
      }
    }
    // company details printed on employment contracts
    match /config/hr {
      allow read, write: if isRole('hr');
    }
    match /custody/{id} {
      allow read, write: if isRole('hr');
    }
    match /advances/{id} {
      allow read, write: if isRole('hr');
    }
    // company licenses and contracts, with one attached photo each
    match /licenses/{id} {
      allow read, write: if isRole('hr');
      match /files/{f} {
        allow read, delete: if isRole('hr');
        allow create, update: if isRole('hr') && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      }
    }
    // branch staff list (no salaries): the branch manages its own; HR and operations read
    match /staff/{id} {
      allow read: if isRole('hr') || isMgr() || (isBranch() && resource.data.branch == myBranch());
      // entries copied from HR (fromHR) can only be changed by HR
      allow create: if isRole('hr') || (isBranch() && request.resource.data.branch == myBranch() && !request.resource.data.get('fromHR', false));
      allow update: if isRole('hr') || (isBranch() && resource.data.branch == myBranch() && !resource.data.get('fromHR', false) && request.resource.data.branch == myBranch() && !request.resource.data.get('fromHR', false));
      allow delete: if isRole('hr') || (isBranch() && resource.data.branch == myBranch() && !resource.data.get('fromHR', false));
    }
    // weekly shift schedule per branch
    match /shifts/{id} {
      allow read: if isRole('hr') || isMgr() || (isBranch() && resource.data.branch == myBranch());
      allow create: if isBranch() && request.resource.data.branch == myBranch();
      allow update: if isBranch() && resource.data.branch == myBranch() && request.resource.data.branch == myBranch();
      allow delete: if isMgr();
    }

    // monthly payroll sheets: HR only
    match /payroll/{id} {
      allow read, write: if isRole('hr');
    }
    // payment vouchers: HR only
    match /vouchers/{id} {
      allow read, write: if isRole('hr');
    }
    // deduction / warning / reward forms: a branch files for its staff, HR approves (or issues its own)
    match /forms/{id} {
      allow read: if isRole('hr') || (isBranch() && resource.data.branch == myBranch());
      allow create: if isRole('hr') || (isBranch() && request.resource.data.branch == myBranch() && request.resource.data.status == 'pending' && request.resource.data.by == 'branch');
      allow update: if isRole('hr');
      allow delete: if isRole('hr') || (isBranch() && resource.data.branch == myBranch() && resource.data.status == 'pending');
    }

    // leave requests: a branch files and can withdraw its own pending ones; HR decides
    match /leaveReqs/{id} {
      allow read: if isRole('hr') || (isBranch() && resource.data.branch == myBranch());
      allow create: if isBranch() && request.resource.data.branch == myBranch() && request.resource.data.status == 'pending';
      allow update: if isRole('hr');
      allow delete: if isRole('hr') || (isBranch() && resource.data.branch == myBranch() && resource.data.status == 'pending');
    }
    match /leaves/{id} {
      allow read, write: if isRole('hr');
    }

    match /orders/{id} {
      allow read: if valid()
        && (sess().role in ['manager', 'warehouse']
            || (sess().role == 'branch' && resource.data.branch == sess().branch));
      allow create: if valid()
        && (sess().role == 'manager'
            || (sess().role == 'branch' && request.resource.data.branch == sess().branch && request.resource.data.status == 'pending'));
      allow update: if valid()
        && (sess().role in ['manager', 'warehouse']
            || (sess().role == 'branch' && resource.data.branch == sess().branch && request.resource.data.branch == sess().branch));
      // operations may delete any order; a branch only its own order while still pending
      allow delete: if valid()
        && (sess().role == 'manager'
            || (sess().role == 'branch' && resource.data.branch == sess().branch && resource.data.status == 'pending'));
    }
  }
}
